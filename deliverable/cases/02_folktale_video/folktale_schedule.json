[
 {
  "start": 0.3,
  "end": 3.237,
  "text": "老辈人常说：木匠忌讳接三更活，",
  "clip": "line_01.mp3",
  "dur": 2.937
 },
 {
  "start": 3.487,
  "end": 5.02,
  "text": "渡人莫渡无影客。",
  "clip": "line_02.mp3",
  "dur": 1.533
 },
 {
  "start": 5.27,
  "end": 7.569,
  "text": "可乾隆十八年的除夕雪夜，",
  "clip": "line_03.mp3",
  "dur": 2.299
 },
 {
  "start": 7.819,
  "end": 9.56,
  "text": "徽州老木匠陈三斤，",
  "clip": "line_04.mp3",
  "dur": 1.742
 },
 {
  "start": 9.81,
  "end": 12.062,
  "text": "偏偏接了一单不露脸的急活。",
  "clip": "line_05.mp3",
  "dur": 2.252
 },
 {
  "start": 12.312,
  "end": 16.492,
  "text": "那天雪下得正紧，柴门被叩响三声。",
  "clip": "line_06.mp3",
  "dur": 4.18
 },
 {
  "start": 16.742,
  "end": 19.598,
  "text": "门外立着一个披蓑衣的黑影，看不清脸，",
  "clip": "line_07.mp3",
  "dur": 2.856
 },
 {
  "start": 19.848,
  "end": 23.552,
  "text": "只递进一锭冰凉的官银：老师傅，",
  "clip": "line_08.mp3",
  "dur": 3.704
 },
 {
  "start": 23.802,
  "end": 26.402,
  "text": "照这尺寸，打一口小匣子。",
  "clip": "line_09.mp3",
  "dur": 2.601
 },
 {
  "start": 26.652,
  "end": 27.674,
  "text": "今夜就要。",
  "clip": "line_10.mp3",
  "dur": 1.022
 },
 {
  "start": 27.924,
  "end": 29.538,
  "text": "陈三斤本不想接，",
  "clip": "line_11.mp3",
  "dur": 1.614
 },
 {
  "start": 29.788,
  "end": 32.423,
  "text": "可想起家中卧病的老妻等着抓药，",
  "clip": "line_12.mp3",
  "dur": 2.635
 },
 {
  "start": 32.673,
  "end": 34.508,
  "text": "还是把银子攥进了手心。",
  "clip": "line_13.mp3",
  "dur": 1.834
 },
 {
  "start": 34.758,
  "end": 38.682,
  "text": "他点起灯开工，越做越不对：那木料奇香，",
  "clip": "line_14.mp3",
  "dur": 3.924
 },
 {
  "start": 38.932,
  "end": 41.695,
  "text": "入手沉如铁；量尺寸时，",
  "clip": "line_15.mp3",
  "dur": 2.763
 },
 {
  "start": 41.945,
  "end": 45.265,
  "text": "鲁班尺上病离二字正对木纹；",
  "clip": "line_16.mp3",
  "dur": 3.32
 },
 {
  "start": 45.515,
  "end": 48.325,
  "text": "而门外雪地上，来时的一行脚印，",
  "clip": "line_17.mp3",
  "dur": 2.81
 },
 {
  "start": 48.575,
  "end": 50.061,
  "text": "竟浅得几乎看不见。",
  "clip": "line_18.mp3",
  "dur": 1.486
 },
 {
  "start": 50.311,
  "end": 54.317,
  "text": "三更天，匣子将成，村口忽然传来锣声。",
  "clip": "line_19.mp3",
  "dur": 4.005
 },
 {
  "start": 54.567,
  "end": 57.457,
  "text": "乡邻披衣来报：渡口的无影客又出来了，",
  "clip": "line_20.mp3",
  "dur": 2.891
 },
 {
  "start": 57.707,
  "end": 60.134,
  "text": "专在除夕夜敲老实人的门！",
  "clip": "line_21.mp3",
  "dur": 2.426
 },
 {
  "start": 60.384,
  "end": 63.797,
  "text": "众人劝他把银子扔了，陈三斤却摇摇头：",
  "clip": "line_22.mp3",
  "dur": 3.413
 },
 {
  "start": 64.047,
  "end": 66.091,
  "text": "活可以不做，人不能失信。",
  "clip": "line_23.mp3",
  "dur": 2.043
 },
 {
  "start": 66.341,
  "end": 67.525,
  "text": "他提灯出了门。",
  "clip": "line_24.mp3",
  "dur": 1.184
 },
 {
  "start": 67.775,
  "end": 70.759,
  "text": "雪地尽头，蓑衣客接过匣子，",
  "clip": "line_25.mp3",
  "dur": 2.984
 },
 {
  "start": 71.009,
  "end": 72.367,
  "text": "缓缓掀开斗笠，",
  "clip": "line_26.mp3",
  "dur": 1.358
 },
 {
  "start": 72.617,
  "end": 76.413,
  "text": "竟是二十年前那个被他从冰河里捞起",
  "clip": "line_27.mp3",
  "dur": 3.796
 },
 {
  "start": 76.663,
  "end": 79.218,
  "text": "的落难书生，如今的新任县令！",
  "clip": "line_28.mp3",
  "dur": 2.554
 },
 {
  "start": 79.468,
  "end": 82.835,
  "text": "当年一饭一宿之恩，今夜以官银相谢，",
  "clip": "line_29.mp3",
  "dur": 3.367
 },
 {
  "start": 83.085,
  "end": 85.082,
  "text": "并赠良药医其老妻。",
  "clip": "line_30.mp3",
  "dur": 1.997
 },
 {
  "start": 85.332,
  "end": 86.562,
  "text": "所谓无影客，",
  "clip": "line_31.mp3",
  "dur": 1.231
 },
 {
  "start": 86.812,
  "end": 89.448,
  "text": "不过是有钱人装鬼试人心的旧把戏，",
  "clip": "line_32.mp3",
  "dur": 2.635
 },
 {
  "start": 89.698,
  "end": 91.532,
  "text": "被好心人讹传至今。",
  "clip": "line_33.mp3",
  "dur": 1.834
 },
 {
  "start": 91.782,
  "end": 94.127,
  "text": "后来徽州人都记住了陈三斤的话：",
  "clip": "line_34.mp3",
  "dur": 2.345
 },
 {
  "start": 94.377,
  "end": 96.722,
  "text": "手艺人守的是规矩，行的是良心。",
  "clip": "line_35.mp3",
  "dur": 2.345
 },
 {
  "start": 96.972,
  "end": 99.956,
  "text": "老话讲：但行好事，莫问前程。",
  "clip": "line_36.mp3",
  "dur": 2.984
 },
 {
  "start": 100.206,
  "end": 102.888,
  "text": "您说，这世道是不是这个理？",
  "clip": "line_37.mp3",
  "dur": 2.682
 },
 {
  "start": 103.138,
  "end": 107.608,
  "text": "评论区留下善有善报，为家人积一份福。",
  "clip": "line_38.mp3",
  "dur": 4.47
 }
]