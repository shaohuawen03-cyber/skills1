[
 {
  "start": 1.88,
  "end": 3.81,
  "text": "老辈人常说：木匠忌讳接三更活"
 },
 {
  "start": 3.96,
  "end": 6.33,
  "text": "渡人莫渡无影客"
 },
 {
  "start": 6.48,
  "end": 9.1,
  "text": "乾隆十八年的除夕雪夜\n他接了一单不露脸的急活"
 },
 {
  "start": 14.32,
  "end": 17.64,
  "text": "那天雪下得正紧\n柴门被叩响三声"
 },
 {
  "start": 17.79,
  "end": 20.29,
  "text": "门外立着披蓑衣的黑影 看不清脸"
 },
 {
  "start": 25.49,
  "end": 27.54,
  "text": "只递进一锭冰凉的官银"
 },
 {
  "start": 28.09,
  "end": 32.15,
  "text": "照这尺寸 打一口小匣子\n今夜就要"
 },
 {
  "start": 32.3,
  "end": 34.91,
  "text": "陈三斤本不想接"
 },
 {
  "start": 35.059999999999995,
  "end": 37.559999999999995,
  "text": "可想起卧病老妻等着抓药\n他攥紧了银子"
 },
 {
  "start": 44.8,
  "end": 47.9,
  "text": "他点起灯开工 越做越不对"
 },
 {
  "start": 48.32,
  "end": 51.69,
  "text": "那木料奇香 入手沉如铁"
 },
 {
  "start": 53.11,
  "end": 56.79,
  "text": "鲁班尺上\"病\"\"离\"二字\n正对木纹"
 },
 {
  "start": 57.03,
  "end": 60.34,
  "text": "门外雪地上 来时的一行脚印"
 },
 {
  "start": 61.14,
  "end": 63.13,
  "text": "竟浅得几乎看不见"
 },
 {
  "start": 63.28,
  "end": 65.78,
  "text": "这单三更活 处处透着古怪"
 },
 {
  "start": 65.93,
  "end": 68.43,
  "text": "他越想越心惊 却停不下手\n匣子将成 天已三更"
 },
 {
  "start": 68.58000000000001,
  "end": 71.08000000000001,
  "text": "三更天 村口忽然传来锣声"
 },
 {
  "start": 71.23000000000002,
  "end": 73.28,
  "text": "乡邻披衣来报：\n渡口的无影客又出来了！"
 },
 {
  "start": 73.43,
  "end": 75.24,
  "text": "专在除夕夜敲老实人的门"
 },
 {
  "start": 75.76,
  "end": 78.02,
  "text": "众人劝他把银子扔了"
 },
 {
  "start": 81.72,
  "end": 83.33,
  "text": "陈三斤摇摇头：\n活可以不做 人不能失信"
 },
 {
  "start": 83.48,
  "end": 84.96,
  "text": "他提灯出了门"
 },
 {
  "start": 85.11,
  "end": 87.61,
  "text": "走进漫天风雪里"
 },
 {
  "start": 87.76,
  "end": 88.73,
  "text": "雪地尽头 蓑衣客接过匣子"
 },
 {
  "start": 88.88000000000001,
  "end": 90.54,
  "text": "缓缓掀开斗笠"
 },
 {
  "start": 93.21,
  "end": 98.09,
  "text": "竟是二十年前\n被他从冰河里捞起的落难书生！"
 },
 {
  "start": 98.24000000000001,
  "end": 100.17,
  "text": "如今的新任县令"
 },
 {
  "start": 104.33,
  "end": 105.59,
  "text": "以官银谢一饭一宿之恩\n并赠良药医其老妻"
 },
 {
  "start": 106.32,
  "end": 109.12,
  "text": "原来如此"
 },
 {
  "start": 109.27000000000001,
  "end": 111.77000000000001,
  "text": "所谓无影客\n不过是试人心的把戏"
 },
 {
  "start": 115.64,
  "end": 120.16,
  "text": "手艺人守的是规矩\n行的是良心"
 },
 {
  "start": 120.65,
  "end": 122.06,
  "text": "但行好事 莫问前程"
 },
 {
  "start": 123.26,
  "end": 125.48,
  "text": "善有善报\n评论区留下您的祝福"
 }
]