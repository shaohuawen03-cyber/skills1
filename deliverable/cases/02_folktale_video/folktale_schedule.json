[
 {
  "start": 0.416,
  "end": 4.721,
  "text": "那天雪下得正紧，柴门被叩响三声。"
 },
 {
  "start": 4.757,
  "end": 9.828,
  "text": "门外立着一个披蓑衣的黑影，看不清脸，"
 },
 {
  "start": 9.864,
  "end": 13.248,
  "text": "只递进一锭冰凉的官银：老师傅，"
 },
 {
  "start": 13.285,
  "end": 16.45,
  "text": "照这尺寸，打一口小匣子。"
 },
 {
  "start": 16.681,
  "end": 17.512,
  "text": "今夜就要。"
 },
 {
  "start": 17.548,
  "end": 19.68,
  "text": "陈三斤本不想接，"
 },
 {
  "start": 19.717,
  "end": 24.567,
  "text": "可想起家中卧病的老妻等着抓药，"
 },
 {
  "start": 24.603,
  "end": 28.57,
  "text": "还是把银子攥进了手心。"
 },
 {
  "start": 28.606,
  "end": 33.906,
  "text": "他点起灯开工，越做越不对：那木料奇香，"
 },
 {
  "start": 33.942,
  "end": 36.736,
  "text": "入手沉如铁；量尺寸时，"
 },
 {
  "start": 36.772,
  "end": 40.422,
  "text": "鲁班尺上病离二字正对木纹；"
 },
 {
  "start": 40.458,
  "end": 45.886,
  "text": "而门外雪地上，来时的一行脚印，"
 },
 {
  "start": 45.922,
  "end": 48.721,
  "text": "竟浅得几乎看不见。"
 },
 {
  "start": 48.757,
  "end": 54.727,
  "text": "三更天，匣子将成，村口忽然传来锣声。"
 },
 {
  "start": 54.763,
  "end": 59.73,
  "text": "乡邻披衣来报：渡口的无影客又出来了，"
 },
 {
  "start": 59.766,
  "end": 64.363,
  "text": "专在除夕夜敲老实人的门！"
 },
 {
  "start": 64.399,
  "end": 69.806,
  "text": "众人劝他把银子扔了，陈三斤却摇摇头："
 },
 {
  "start": 69.842,
  "end": 72.787,
  "text": "活可以不做，人不能失信。"
 },
 {
  "start": 72.823,
  "end": 74.943,
  "text": "他提灯出了门。"
 },
 {
  "start": 74.979,
  "end": 78.749,
  "text": "雪地尽头，蓑衣客接过匣子，"
 },
 {
  "start": 78.785,
  "end": 80.664,
  "text": "缓缓掀开斗笠，"
 },
 {
  "start": 80.7,
  "end": 86.036,
  "text": "竟是二十年前那个被他从冰河里捞起"
 },
 {
  "start": 86.072,
  "end": 89.301,
  "text": "的落难书生，如今的新任县令！"
 },
 {
  "start": 89.337,
  "end": 94.299,
  "text": "当年一饭一宿之恩，今夜以官银相谢，"
 },
 {
  "start": 94.335,
  "end": 97.166,
  "text": "并赠良药医其老妻。"
 },
 {
  "start": 97.202,
  "end": 98.828,
  "text": "所谓无影客，"
 },
 {
  "start": 98.864,
  "end": 103.399,
  "text": "不过是有钱人装鬼试人心的旧把戏，"
 },
 {
  "start": 103.435,
  "end": 105.308,
  "text": "被好心人讹传至今。"
 },
 {
  "start": 105.344,
  "end": 110.608,
  "text": "后来徽州人都记住了陈三斤的话："
 },
 {
  "start": 110.644,
  "end": 114.872,
  "text": "手艺人守的是规矩，行的是良心。"
 },
 {
  "start": 114.908,
  "end": 118.726,
  "text": "老话讲：但行好事，莫问前程。"
 },
 {
  "start": 118.763,
  "end": 122.176,
  "text": "您说，这世道是不是这个理？"
 },
 {
  "start": 123.255,
  "end": 128.15,
  "text": "评论区留下善有善报，为家人积一份福。"
 }
]