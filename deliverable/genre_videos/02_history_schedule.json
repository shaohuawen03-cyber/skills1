[
 {
  "start": 0.3,
  "end": 3.72,
  "text": "一千年前 有个大文豪"
 },
 {
  "start": 7.33,
  "end": 10.13,
  "text": "一生被贬三次 却活成最羡慕的样子"
 },
 {
  "start": 10.67,
  "end": 16.14,
  "text": "乌台诗案 他差点死在牢里"
 },
 {
  "start": 16.29,
  "end": 18.06,
  "text": "被贬黄州 他买地种粮 炖出东坡肉"
 },
 {
  "start": 22.31,
  "end": 24.26,
  "text": "三贬儋州 他办学堂挖水井"
 },
 {
  "start": 29.59,
  "end": 32.37,
  "text": "回首向来萧瑟处 也无风雨也无晴"
 }
]