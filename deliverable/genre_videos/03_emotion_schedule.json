[
 {
  "start": 0.3,
  "end": 3.063,
  "text": "你有多久，没有好好心疼自己了？",
  "clip": "clip_01.mp3",
  "dur": 2.763
 },
 {
  "start": 3.313,
  "end": 8.514,
  "text": "人到中年，上有老下有小，不敢病、不敢停、",
  "clip": "clip_02.mp3",
  "dur": 5.201
 },
 {
  "start": 8.764,
  "end": 9.658,
  "text": "不敢倒。",
  "clip": "clip_03.mp3",
  "dur": 0.894
 },
 {
  "start": 9.908,
  "end": 13.182,
  "text": "深夜的酒，解不了清晨的粥难。",
  "clip": "clip_04.mp3",
  "dur": 3.274
 },
 {
  "start": 13.432,
  "end": 16.114,
  "text": "可你别忘了，那个淋着雨还在赶路的人，",
  "clip": "clip_05.mp3",
  "dur": 2.682
 },
 {
  "start": 16.364,
  "end": 17.514,
  "text": "也值得一盏灯。",
  "clip": "clip_06.mp3",
  "dur": 1.149
 },
 {
  "start": 17.764,
  "end": 20.62,
  "text": "累了就歇一歇，天塌不下来。",
  "clip": "clip_07.mp3",
  "dur": 2.856
 },
 {
  "start": 20.87,
  "end": 24.875,
  "text": "你不是一个人在扛，屏幕前的我，也在扛。",
  "clip": "clip_08.mp3",
  "dur": 4.005
 },
 {
  "start": 25.125,
  "end": 28.109,
  "text": "留言告诉我，你今天最想说的一句话。",
  "clip": "clip_09.mp3",
  "dur": 2.984
 },
 {
  "start": 28.359,
  "end": 31.772,
  "text": "愿你三冬暖，愿你春不寒。",
  "clip": "clip_10.mp3",
  "dur": 3.413
 }
]